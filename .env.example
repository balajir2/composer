# Composer — environment variable template.
# Copy this file to .env and fill in the values.
#
# Keys are grouped by the phase that first consumes them. Placeholders for
# later-phase keys are included so .env stays stable as phases ship; they
# can be left empty until the owning phase lands.

# ─── App (Phase 0) ────────────────────────────
APP_NAME=composer
ENVIRONMENT=development
LOG_LEVEL=INFO

# ─── Database (Phase 1) ───────────────────────
# Neon (serverless Postgres) — free tier is enough for dev.
# Format:
#   postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require
DATABASE_URL=

# Separate DB for integration tests. Point at a scratch Neon branch or
# an ephemeral Postgres (e.g. GitHub Actions postgres service in CI).
# Unit tests don't need this.
TEST_DATABASE_URL=

# ─── Auth (Phase 1 library / Phase 7 middleware) ──
# JWT primitives exist from Phase 1 but middleware is wired in Phase 7.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=604800

# ─── Encryption (Phase 3 for MCP OAuth token storage) ──
# 32-byte base64 key for stored secrets. Generate with:
# python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

# ─── LLM providers (Phase 2) ──────────────────
# OPTIONAL — Composer reads provider keys in this order:
#   1. The env var listed here (.env locally; Cloud Run env vars in prod).
#   2. The `llm_api_keys` table in Postgres, populated via the admin UI
#      (Admin → LLM keys) and decrypted into Settings on app startup
#      (src/security/key_sync.py).
# Env wins when both are set — useful as a dev-only override to shadow a
# stale prod key.  Leave these blank in production if you want to manage
# keys exclusively via the admin UI; a Cloud Run revision restart (or a
# local `uvicorn` restart) picks up changes.
#
# Provisioning:
#   ANTHROPIC_API_KEY — https://console.anthropic.com (Settings → API Keys)
#   OPENAI_API_KEY    — https://platform.openai.com (API keys)
#   GOOGLE_API_KEY    — https://aistudio.google.com (Get API key)
#   GROQ_API_KEY      — https://console.groq.com (API Keys)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# ─── LangSmith tracing (Phase 2, optional) ────
# DEV-ONLY override; production syncs from Postgres via `composer keys sync`.
# Enable by setting LANGCHAIN_TRACING_V2=true + providing LANGCHAIN_API_KEY.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=composer
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ─── Agent tools (Phase 2: Tavily; Phase 6: rest) ──
# DEV-ONLY override; production syncs from Postgres via `composer keys sync`.
# TAVILY_API_KEY — free tier 1000 calls/mo — https://tavily.com
TAVILY_API_KEY=
# Phase 6 integration keys — leave empty until Phase 6 lands.
SERPER_API_KEY=
FIRECRAWL_API_KEY=
BROWSERLESS_API_KEY=
GAMMA_API_KEY=
RESEND_API_KEY=

# ─── E2B code interpreter (Phase 4 Transform node) ──
# https://e2b.dev — leave empty until Phase 4 lands.
E2B_API_KEY=

# ─── SSO (Phase 10a) ──────────────────────────
# Set SSO_ENABLED=true to accept Azure-AD-issued JWTs via /auth/sso-exchange.
# Requires the two tenant config values below to be populated.
SSO_ENABLED=false
SSO_AZURE_AD_TENANT_ID=
SSO_AZURE_AD_EXPECTED_AUDIENCE=

# ─── CORS (production standalone deploys) ─────
# Comma-separated frontend origins allowed by CORS when ENVIRONMENT=production
# and COMPOSER_DEPLOYMENT_MODE=standalone. Each entry must be an exact match
# on scheme+host+port (no trailing slash, no path).
# Example:
#   COMPOSER_FRONTEND_ORIGINS=https://composer.example.com,https://composer-frontend-xyz-uc.a.run.app
# Local dev (ENVIRONMENT=development) ignores this and allows '*'.
COMPOSER_FRONTEND_ORIGINS=

# ─── Deploy sync (Phase 9e) ───────────────────
# For `composer keys sync --target vercel`. Dev machines don't need these.
# VERCEL_API_TOKEN: Vercel account token with env-var-write scope.
# VERCEL_PROJECT_ID: ID of the Vercel project to push env vars into.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=

# ─── Migration (Phase 9b) ─────────────────────
# For `composer migrate` — set when running the OAB->Composer migration.
# OAB_MCP_OAUTH_ENCRYPTION_KEY: the key OAB used to encrypt mcpOAuthTokens.
# (Composer's own ENCRYPTION_KEY is already set above.)
OAB_MCP_OAUTH_ENCRYPTION_KEY=
