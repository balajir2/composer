# Composer — environment variable template.
# Copy this file to .env and fill in the values.

# ─── App ──────────────────────────────────────
APP_NAME=composer
ENVIRONMENT=development
LOG_LEVEL=INFO

# ─── Database ─────────────────────────────────
# Neon (serverless Postgres) — free tier is enough for dev.
# Format:
#   postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require
DATABASE_URL=

# Separate DB for integration tests. Point at a scratch Neon branch or
# an ephemeral Postgres (e.g. GitHub Actions postgres service in CI).
# Unit tests don't need this.
TEST_DATABASE_URL=

# ─── Auth ─────────────────────────────────────
# JWT primitives exist from Phase 1 but middleware is wired in Phase 7.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=604800

# ─── Encryption (AES-256-GCM) ─────────────────
# 32-byte base64 key for stored secrets. Generate with:
# python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

# ─── LangSmith tracing (optional) ─────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=composer
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
